{
  "version": "1.0.0",
  "packs": [
    {
      "id": "deep-sea",
      "name": "深海",
      "stageNames": [
        "暮光区",
        "深海区",
        "深渊区",
        "海沟区"
      ],
      "entries": [
        {
          "id": "anglerfish",
          "stage": 1,
          "name": "约翰逊鮟鱇鱼",
          "emoji": "🐟",
          "summary": "头顶发光诱饵的小型捕食者，生活在光线很弱的暮光区。",
          "knowledgeCards": [
            "鮟鱇鱼的“灯笼”其实是背鳍演化来的。",
            "它们用发光诱饵吸引小鱼。",
            "雌鱼比雄鱼大很多。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "lanternfish",
          "stage": 1,
          "name": "灯笼鱼",
          "emoji": "🐠",
          "summary": "暮光区数量最多的鱼类之一，会进行昼夜垂直迁移。",
          "knowledgeCards": [
            "白天躲在深水，夜里上浮觅食。",
            "身体侧面的发光器可以帮助同类识别。",
            "它们是许多大型深海动物的重要食物。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "cusk-eel",
          "stage": 2,
          "name": "深海大鼬鳚",
          "emoji": "🐍",
          "summary": "身体细长、像鳗鱼一样的底栖鱼类，常在海底缓慢游动。",
          "knowledgeCards": [
            "它们喜欢躲在泥沙和岩石缝隙里。",
            "靠嗅觉寻找小型甲壳类。",
            "深海大鼬鳚的背鳍和臀鳍很长。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "lizardfish",
          "stage": 2,
          "name": "深海蜥鱼",
          "emoji": "🦎",
          "summary": "伏击型捕食者，常把身体埋在海底泥沙中等待猎物。",
          "knowledgeCards": [
            "嘴巴里有许多细小的牙齿。",
            "它们能长时间保持不动。",
            "深海蜥鱼的眼睛位置靠上，方便观察上方。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "jewel-squid",
          "stage": 3,
          "name": "宝石鱿鱼",
          "emoji": "🦑",
          "summary": "皮肤会反射光线的头足类，像一颗会游泳的宝石。",
          "knowledgeCards": [
            "皮肤里的发光细胞能改变颜色。",
            "遇到危险时会喷出墨汁。",
            "宝石鱿鱼用触手抓住小型鱼虾。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "tube-worm",
          "stage": 3,
          "name": "巨型管虫",
          "emoji": "🪱",
          "summary": "生活在热液喷口附近的管虫，靠体内细菌制造养分。",
          "knowledgeCards": [
            "它们没有嘴巴和消化系统。",
            "体内的共生细菌把化学能变成养分。",
            "热液喷口的水温很高，但管虫能适应。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "sea-star",
          "stage": 4,
          "name": "深海海星",
          "emoji": "⭐",
          "summary": "在深海海底缓慢移动的棘皮动物，靠管足抓握食物。",
          "knowledgeCards": [
            "海星可以再生失去的腕。",
            "它们用管足移动和感知。",
            "有些深海海星以腐殖质为食。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        },
        {
          "id": "vampire-squid",
          "stage": 4,
          "name": "幽灵蛸",
          "emoji": "🐙",
          "summary": "深海中颜色暗红、带膜状腕的头足类，常被叫作“吸血鬼鱿鱼”。",
          "knowledgeCards": [
            "遇到危险时会把腕翻过来保护身体。",
            "它们并不吸血，主要吃“海洋雪”。",
            "幽灵蛸生活在氧气很少的深水。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ]
        }
      ]
    },
    {
      "id": "dinosaur",
      "name": "恐龙",
      "stageNames": [
        "化石营地",
        "蕨类森林",
        "火山谷",
        "恐龙乐园"
      ],
      "entries": [
        {
          "id": "triceratops",
          "stage": 1,
          "name": "三角龙",
          "emoji": "🦕",
          "summary": "头上有三只角和巨大颈盾的植食恐龙，生活在白垩纪晚期。",
          "knowledgeCards": [
            "三角龙的颈盾可能用于展示或保护。",
            "它们用喙状嘴切断植物。",
            "三角龙和霸王龙生活在同一时期。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "triceratops",
          "modelSource": "https://poly.pizza/m/IGvrUqGrRM",
          "modelLicense": "CC0",
          "photoRef": "triceratops",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Triceratops_Skeleton_-_National_Museum_of_Natural_History_(14611729991)a.jpg",
          "photoCredit": "Gareth Milner; derivative by MathKnight",
          "photoLicense": "CC BY 4.0"
        },
        {
          "id": "stegosaurus",
          "stage": 1,
          "name": "剑龙",
          "emoji": "🦴",
          "summary": "背上有两排大骨板的植食恐龙，尾巴末端有骨刺。",
          "knowledgeCards": [
            "骨板可能用于展示或调节体温。",
            "剑龙的脑袋很小，身体很大。",
            "尾巴上的骨刺可以防御捕食者。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "stegosaurus",
          "modelSource": "https://poly.pizza/m/eFcNbOlpvl",
          "modelLicense": "CC0",
          "photoRef": "stegosaurus",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Stegosaurus_Skeleton_(36094963090).jpg",
          "photoCredit": "Gary Todd",
          "photoLicense": "CC0"
        },
        {
          "id": "tyrannosaurus",
          "stage": 2,
          "name": "霸王龙",
          "emoji": "🦖",
          "summary": "大型肉食恐龙，有强壮的后肢和巨大的颌骨。",
          "knowledgeCards": [
            "霸王龙的牙齿像香蕉一样粗。",
            "它的前肢很短，但很有力。",
            "霸王龙可能既捕猎也吃腐肉。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "tyrannosaurus",
          "modelSource": "https://poly.pizza/m/UYtneO5FpF",
          "modelLicense": "CC0",
          "photoRef": "tyrannosaurus",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Tyrannosaurus_Rex_skeleton_is_on_display_in_the_Dinosaurs_hall_at_the_Smithsonian's_National_Museum_of_Natural_History_in_Washington,_D.C..jpg",
          "photoCredit": "USDAgov",
          "photoLicense": "Public domain"
        },
        {
          "id": "pteranodon",
          "stage": 2,
          "name": "无齿翼龙",
          "emoji": "🪽",
          "summary": "会飞的爬行动物，不是恐龙，但常和恐龙一起出现。",
          "knowledgeCards": [
            "它的翅膀由皮肤膜构成。",
            "无齿翼龙没有牙齿，靠吞食小鱼为生。",
            "它的头冠可能用于展示。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "pteranodon",
          "modelSource": "https://poly.pizza/m/1tuiNTr4-MX",
          "modelLicense": "CC0",
          "photoRef": "pteranodon",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Paläontologisches_Museum_München_-_Pteranodon_back_side.jpg",
          "photoCredit": "ArticCynda",
          "photoLicense": "CC0"
        },
        {
          "id": "apatosaurus",
          "stage": 3,
          "name": "阿普吐龙",
          "emoji": "🦕",
          "summary": "身体很长、脖子较短的植食恐龙，可能成群生活。",
          "knowledgeCards": [
            "阿普吐龙属于蜥脚类恐龙。",
            "它的牙齿适合撕扯植物。",
            "化石显示它可能用尾巴保持平衡。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "apatosaurus",
          "modelSource": "https://poly.pizza/m/fvo0x8Zk3z",
          "modelLicense": "CC0",
          "photoRef": "apatosaurus",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Apatosaurus_skeleton_Field_Columbian_Museum_1.jpg",
          "photoCredit": "The Field Museum Library",
          "photoLicense": "No restrictions"
        },
        {
          "id": "diplodocus",
          "stage": 3,
          "name": "梁龙",
          "emoji": "🦴",
          "summary": "脖子和尾巴都很长的植食恐龙，是蜥脚类中的“长颈鹿”。",
          "knowledgeCards": [
            "梁龙的脖子由许多颈椎组成。",
            "它用钉状牙齿刮取树叶。",
            "梁龙的尾巴可以保持身体平衡。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "diplodocus",
          "modelSource": "https://poly.pizza/m/12n6ICAVpYB",
          "modelLicense": "CC0",
          "photoRef": "diplodocus",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Diplodocus_Carnegii_skeleton_in_Museum_für_Naturkunde_Berlin_0829.jpg",
          "photoCredit": "Dosseman",
          "photoLicense": "CC BY-SA 4.0"
        },
        {
          "id": "velociraptor",
          "stage": 4,
          "name": "迅猛龙",
          "emoji": "🦎",
          "summary": "小型、敏捷的肉食恐龙，可能长有羽毛。",
          "knowledgeCards": [
            "迅猛龙有镰刀状的脚爪。",
            "化石证据显示它可能覆盖羽毛。",
            "它们可能成群活动。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "velociraptor",
          "modelSource": "https://poly.pizza/m/cnlGH2UcDd",
          "modelLicense": "CC0",
          "photoRef": "velociraptor",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Velociraptor_fruita_2.jpg",
          "photoCredit": "Jens Lallensack",
          "photoLicense": "CC BY-SA 4.0"
        },
        {
          "id": "parasaurolophus",
          "stage": 4,
          "name": "副栉龙",
          "emoji": "🎺",
          "summary": "头上有长管状头冠的植食恐龙，可能用头冠发出声音。",
          "knowledgeCards": [
            "头冠内部有复杂的通道。",
            "副栉龙可以用两足或四足行走。",
            "它们生活在白垩纪晚期。"
          ],
          "sources": [
            "https://www.nhm.ac.uk/"
          ],
          "modelRef": "parasaurolophus",
          "modelSource": "https://poly.pizza/m/KeeQrrouRK",
          "modelLicense": "CC0",
          "photoRef": "parasaurolophus",
          "photoSource": "https://commons.wikimedia.org/wiki/File:Parasaurolophus_cyrtocristatus.jpg",
          "photoCredit": "Lisa Andres",
