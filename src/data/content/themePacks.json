        }
      ]
    },
    {
      "id": "space",
      "name": "太空",
      "stageNames": [
        "近地轨道",
        "月球基地",
        "深空航线",
        "星系边缘"
      ],
      "entries": [
        {
          "id": "moon",
          "stage": 1,
          "name": "月球",
          "emoji": "🌕",
          "summary": "地球唯一的天然卫星，表面布满环形山。",
          "knowledgeCards": [
            "月球没有大气层，所以天空是黑的。",
            "月球引力造成地球的潮汐。",
            "宇航员在月球上留下过脚印。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "mars",
          "stage": 1,
          "name": "火星",
          "emoji": "🔴",
          "summary": "太阳系第四颗行星，表面富含氧化铁，看起来呈红色。",
          "knowledgeCards": [
            "火星有太阳系最高的火山。",
            "火星两极有冰盖。",
            "科学家正在寻找火星上的水痕迹。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "jupiter",
          "stage": 2,
          "name": "木星",
          "emoji": "🪐",
          "summary": "太阳系最大的行星，有著名的“大红斑”风暴。",
          "knowledgeCards": [
            "木星主要由氢和氦组成。",
            "大红斑是一个持续很久的巨大风暴。",
            "木星有很多颗卫星。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "saturn",
          "stage": 2,
          "name": "土星",
          "emoji": "🪐",
          "summary": "拥有壮观行星环的气态巨行星。",
          "knowledgeCards": [
            "土星环主要由冰粒和岩石组成。",
            "土星的密度比水还小。",
            "土星也有许多卫星。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "comet",
          "stage": 3,
          "name": "彗星",
          "emoji": "☄️",
          "summary": "由冰、尘埃和岩石组成的小天体，靠近太阳时会形成彗尾。",
          "knowledgeCards": [
            "彗尾总是背向太阳。",
            "彗星来自太阳系边缘。",
            "哈雷彗星大约每 76 年回归一次。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "satellite",
          "stage": 3,
          "name": "人造卫星",
          "emoji": "🛰️",
          "summary": "绕地球运行的人造航天器，用于通信、导航和观测。",
          "knowledgeCards": [
            "卫星可以帮助我们预报天气。",
            "导航卫星帮助定位。",
            "卫星需要能源和通信设备。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "rocket",
          "stage": 4,
          "name": "运载火箭",
          "emoji": "🚀",
          "summary": "把航天器送入太空的交通工具，靠向后喷出气体获得推力。",
          "knowledgeCards": [
            "火箭需要携带氧化剂。",
            "多级火箭会逐级脱落。",
            "火箭的速度要足够快才能进入轨道。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        },
        {
          "id": "galaxy",
          "stage": 4,
          "name": "星系",
          "emoji": "🌌",
          "summary": "由恒星、气体、尘埃和暗物质组成的巨大天体系统。",
          "knowledgeCards": [
            "太阳系位于银河系中。",
            "银河系有数千亿颗恒星。",
            "星系之间会相互吸引和碰撞。"
          ],
          "sources": [
            "https://www.nasa.gov/"
          ]
        }
      ]
    }
  ]
}
